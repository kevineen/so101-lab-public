# configs/lab.local.env — このラボ固有の実値（IP・シリアル等）。コミットしないこと。
#
# 使い方:
#   cp configs/lab.local.env.example configs/lab.local.env
#   # ↑ したうえで自分の環境の値を埋める（空のままの変数は使う機能だけ設定すればよい）
#
# 読まれる場所:
#   - scripts/record_with_buttons.sh / scripts/infer_with_buttons.sh（自動 source）
#   - Python: so101_common.env.load_lab_env()（web_remote / bridges のデバイス設定）
# 手動で一時的に使うとき: set -a && source configs/lab.local.env && set +a
# docs のコマンド例の ${SO101_*} はこのファイルの値に置き換わる。

# --- ホスト (SSH: user@ip)。docs/23_data_transfer.md の rsync/ssh で使用 ---
SO101_PI_SSH=
SO101_GPU_SSH=
SO101_THOR_SSH=
SO101_PI4_SSH=

# --- IP / URL ---
SO101_PI_LAN_IP=            # Pi の LAN IP（記載例: 192.0.2.100 ※文書用のダミー）
SO101_PI_BASE_URL=          # Web Remote の URL（例: http://192.0.2.100:8765）。未設定なら 127.0.0.1 にフォールバック
SO101_MAINPC_LAN_IP=        # メインPC（Quest teleop ホスト）の LAN IP
SO101_CAMERA_XIAO_IP=       # Xiao / ESP32 カメラの IP（記載例: 192.0.2.150 ※文書用のダミー）
SO101_CAMERA_XIAO_URL=      # 同 MJPEG URL（例: http://192.0.2.150:81/stream）
SO101_GPU_TAILSCALE_IP=     # GPU（WSL）の Tailscale IP
SO101_THOR_TAILSCALE_IP=    # Jetson Thor の Tailscale IP
SO101_PI4_TAILSCALE_IP=     # サブ Pi の Tailscale IP
SO101_GPU_LAN_IP=           # GPU（WSL）の LAN IP
SO101_LMSTUDIO_IP=          # LM Studio ホストの IP（SayCan / LLM 実験時のみ）

# --- アーム (USB serial by-id)。lerobot-find-port や ls /dev/serial/by-id/ で調べる ---
SO101_FOLLOWER_PORT=
SO101_LEADER_PORT=

# --- カメラ ---
SO101_REALSENSE_SERIAL=         # RealSense D435 の serial_number（lerobot-find-cameras）
SO101_WRIST_FOLLOWER_DEVICE=    # wrist カメラの /dev/v4l/by-path/... （同じ型番が2台ある場合は必須）
SO101_WRIST_LEADER_DEVICE=

# --- データセット転送（録画後の Pi → GPU オフロード。詳細は docs/23_data_transfer.md）---
# SO101_DATASET_SSH を空にすると Pi ローカルにデータを残す
SO101_DATASET_SSH=
SO101_DATASET_DIR=
SO101_DATASET_DELETE_LOCAL=1

# --- その他 ---
SO101_OPERATOR=             # 実験者名（real_eval の CSV 等に記録される）
# LEROBOT_DIR=              # LeRobot フォークの場所。既定は ~/robot/lerobot（docs/00_repos.md）
